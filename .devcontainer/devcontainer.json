{
  "name": "Interactive RevStr Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "overrideCommand": false,
  "forwardPorts": [],
  "customizations": {
    "vscode": {
      "extensions": [
        "trailofbits.vscode-masm"
      ],
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash",
        "masm.compilerPath": "ml",
        "masm.linkerPath": "link",
        "masm.includePaths": ["z:\\opt\\Irvine32"],
        "masm.libPaths": ["z:\\opt\\Irvine32"]
      }
    }
  },
  "runArgs": ["--init"],
  "overrideCommand": "wine /app/src/revstr-input.exe"
}
