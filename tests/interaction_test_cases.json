{
  "metadata": {
    "test_name": "MASM Interaction Suite",
    "target_exe": "src\\RevStr-input.exe"
  },
  "config": {
    "prompt_pattern": "Enter String: ",
    "exit_command": "exit"
  },
  "test_cases": [
    {
      "id": "TC-001",
      "description": "Standard lowercase",
      "steps": [
        {
          "input": "hello",
          "expected": "hello\r\nolleh",
          "fuzzy_match": true,
          "skip_verification": false
        }
      ]
    },
    {
      "id": "TC-002",
      "description": "Mixed case",
      "steps": [
        {
          "input": "MASM",
          "expected": "MASM\r\nMSAM",
          "fuzzy_match": true,
          "skip_verification": false
        }
      ]
    },
    {
      "id": "TC-003",
      "description": "Spaces included",
      "steps": [
        {
          "input": "123 456",
          "expected": "123 456\r\n654 321",
          "fuzzy_match": true,
          "skip_verification": false
        }
      ]
    },
    {
      "id": "TC-004",
      "description": "Special characters",
      "steps": [
        {
          "input": "!@#$",
          "expected": "!@#$\r\n$#@!",
          "fuzzy_match": true,
          "skip_verification": false
        }
      ]
    }
  ]
}
